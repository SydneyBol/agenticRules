></block></next></block></next></block></statement><statement name="ACTION"><block type="action" id="ai00003"><mutation xmlns="http://www.w3.org/1999/xhtml" iscountertypevector="no" loyaltyaccountid="12" attribute_type_input="give_points"></mutation><field name="action_type">give_points</field><field name="LOYALTY_ACCOUNT">12</field><field name="REWARD_TAGS">BASE</field><value name="FORMULA"><block type="static_value" id="ai00002"><field name="value">100</field></block></value></block></statement></block></statement></block></statement></block></xml>