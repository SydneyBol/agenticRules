<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gravty.spike</groupId>
    <artifactId>engine-harness</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <!--
      Local, offline harness that runs Gravty offer DRL through the REAL engine classes
      (decoder chain, KieUtilities.generateKie, StatelessDroolsExecution, BitExecutionContextImpl,
      EngineMemberImpl, OfferActionHelperImpl, PointsManagerImpl, DateUtils ...).
      The engine is consumed as the prebuilt fat jar (it already bundles Drools 7.73, Jackson,
      log4j2, joda-time, freemarker, ...). Override with -Dengine.jar=/path/to/jar.
    -->
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <engine.version>2.17.0</engine.version>
        <engine.jar>${user.home}/.m2/repository/com/gravty/bit_processor/${engine.version}/bit_processor-${engine.version}-jar-with-dependencies.jar</engine.jar>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.gravty</groupId>
            <artifactId>bit_processor-fat</artifactId>
            <version>${engine.version}</version>
            <scope>system</scope>
            <systemPath>${engine.jar}</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>harness</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- the fat jar ships annotation processors (lombok etc.); we don't need any -->
                    <proc>none</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>harness.Main</mainClass>
                        </manifest>
                        <manifestEntries>
                            <!-- resolved relative to target/harness.jar -->
                            <Class-Path>lib/engine.jar</Class-Path>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <!-- copy the engine fat jar next to harness.jar so `java -jar target/harness.jar` works -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-engine-jar</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <!-- strip leaked BouncyCastle signature files (META-INF/*.SF|DSA|RSA); with them the JVM
                                     rejects the fat jar: "Invalid signature file digest for Manifest main attributes" -->
                                <zip destfile="${project.build.directory}/lib/engine.jar" update="false">
                                    <zipfileset src="${engine.jar}" excludes="META-INF/*.SF,META-INF/*.DSA,META-INF/*.RSA,META-INF/*.EC"/>
                                </zip>
                                <!-- JDK 21+ compat: re-add java.lang.Compiler for MVEL 2.4.x (see src/shim) -->
                                <mkdir dir="${project.build.directory}/shim-classes"/>
                                <exec executable="${java.home}/bin/javac" failonerror="true">
                                    <arg value="--patch-module"/>
                                    <arg value="java.base=${project.basedir}/src/shim/java.base"/>
                                    <arg value="-d"/>
                                    <arg value="${project.build.directory}/shim-classes"/>
                                    <arg value="${project.basedir}/src/shim/java.base/java/lang/Compiler.java"/>
                                </exec>
                                <jar destfile="${project.build.directory}/lib/jdk-compat-shim.jar" basedir="${project.build.directory}/shim-classes"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
