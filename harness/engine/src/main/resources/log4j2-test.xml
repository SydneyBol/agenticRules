<?xml version="1.0" encoding="UTF-8"?>
<!-- log4j2-test.xml takes precedence over the engine fat jar's log4j2.xml. Override level with -Dharness.log.level=DEBUG -->
<Configuration status="ERROR">
    <Appenders>
        <Console name="STDERR" target="SYSTEM_ERR">
            <PatternLayout pattern="[engine %level] %c{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.drools" level="ERROR"/>
        <Logger name="org.kie" level="ERROR"/>
        <Root level="${sys:harness.log.level:-WARN}">
            <AppenderRef ref="STDERR"/>
        </Root>
    </Loggers>
</Configuration>
