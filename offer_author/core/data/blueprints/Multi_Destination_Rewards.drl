    rule "activity-${offer_id}-2" ${offer_priority}
    	when
    		$activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${activity_type}")) && (existInListS(readAttributeS("airport", "origin", null, "airport_name", "${offer_id}"), "${airport_name}"))) )
    	then
    		String ruleTag = "";
    		ReadHelper bitHeader = null;
    		ReadHelper bit = null;
    		ReadHelper bitPayment = null;
    		    ruleTag = "Track # of Flights taken";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
            		$activity.getActionHelper().updateMTA(${offer_id}, "Track # of Flights taken", String.valueOf(bitHeader.readAttributeS("h_destination_airport")), "MA_O", "# Of Flights taken", (1), "INCREMENT_BY", bit,"bit","h_destination_airport");


        ruleTag = "Track Unique Destination Airports Visited";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member", String.valueOf(bitHeader.readAttributeS("h_destination_airport")),"MA_O", "# Of Flights taken", "${offer_id}") == (1))){
        	    		$activity.getActionHelper().updateMTA(${offer_id}, "Track Unique Destination Airports Visited", "MA_O", "# of Unique Destination Airports Visited", (1), "INCREMENT_BY", bit);

        }ruleTag = "Reward on Achieving the Milestone";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member",null,"MA_O", "# of Unique Destination Airports Visited", "${offer_id}") == (${unique_origin_airport_target_1}))){
        	    		$activity.getActionHelper().assignPrivilege(${offer_id}, "Reward on Achieving the Milestone", "${voucher}", (${voucher_value}), (${voucher_quantity}),null,null, bit);

        }
    end
