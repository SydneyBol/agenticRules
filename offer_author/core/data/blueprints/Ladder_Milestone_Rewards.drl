  rule "activity-${offer_id}-2" ${offer_priority}
                  when
                    $activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${activity}"))) )
                  then
                    String ruleTag = "";
                    ReadHelper bitHeader = null;
                    ReadHelper bit = null;
                    ReadHelper bitPayment = null;
                      ruleTag = "Track Eligible Stays";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if((bitHeader.readAttributeN("h_no_of_nights") >= (${minimum_nights_per_stay}))){
                  		$activity.getActionHelper().updateMTA(${offer_id}, "Track Eligible Stays", "MA_O", "Stays Completed", (1), "INCREMENT_BY", bit);

      ruleTag = "Reward upto Progressive Reward Stay Limit";
                bitHeader = $activity.getHeaderReadHelper();
                bit = $activity.getHeaderReadHelper();
                if(($activity.readAttributeN("member",null,"MA_O", "Stays Completed", "${offer_id}") > (0)) &&
        ($activity.readAttributeN("member",null,"MA_O", "Stays Completed", "${offer_id}") <= (${stay_milestone_1}))){
                    		$activity.getActionHelper().pointsAction("${loyalty_tag}", ${offer_id}, "Reward upto Progressive Reward Stay Limit", "REWARD_POINTS", "${loyalty_account}", ((($activity.readAttributeN("member",null,"MA_O", "Stays Completed", "${offer_id}"))*(${base_reward_amount}))), bit);

                }
      ruleTag = "Reward upto Maximum Stay Limit";
                bitHeader = $activity.getHeaderReadHelper();
                bit = $activity.getHeaderReadHelper();
                if(($activity.readAttributeN("member",null,"MA_O", "Stays Completed", "${offer_id}") >= (((${stay_milestone_1})+(1)))) &&
        ($activity.readAttributeN("member",null,"MA_O", "Stays Completed", "${offer_id}") <= (${stay_milestone_3}))){
                    		$activity.getActionHelper().pointsAction("${loyalty_tag}", ${offer_id}, "Reward upto Maximum Stay Limit", "REWARD_POINTS", "${loyalty_account}", (((((${stay_milestone_1})+(1)))*(${base_reward_amount}))), bit);

                }
              }
                end
