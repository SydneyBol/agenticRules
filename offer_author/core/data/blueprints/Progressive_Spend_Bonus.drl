  rule "activity-${offer_id}-2" ${offer_priority}
                  when
                    $activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${activity_type}"))) )
                  then
                    String ruleTag = "";
                    ReadHelper bitHeader = null;
                    ReadHelper bit = null;
                    ReadHelper bitPayment = null;
                      ruleTag = "Track Different Activity";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if((bitHeader.readAttributeN("h_bit_amount") >= (${minimum_spend_threshold_}))){
                  		$activity.getActionHelper().updateMTA(${offer_id}, "Track Different Activity", "MA_O", "Member Activity", (1), "INCREMENT_BY", bit);

              }
    ruleTag = "Reward on the First Activity";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeN("member",null,"MA_O", "Member Activity", "${offer_id}") == (1))){
                  		$activity.getActionHelper().pointsAction("${tag}", ${offer_id}, "Reward on the First Activity", "REWARD_POINTS", "${loyalty_account}", (${bonus_points}), bit);

              }
    ruleTag = "Reward on the Second Activity";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeN("member",null,"MA_O", "Member Activity", "${offer_id}") == (2))){
                  		$activity.getActionHelper().pointsAction("${tag}", ${offer_id}, "Reward on the Second Activity", "REWARD_POINTS", "${loyalty_account}", (${bonus_points_2}), bit);

              }
    ruleTag = "Reward on the Third Activity";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeN("member",null,"MA_O", "Member Activity", "${offer_id}") == (3))){
                  		$activity.getActionHelper().assignPrivilege(${offer_id}, "Reward on the Third Activity", "${third_activity_voucher}", "${third_activity_voucher_usage_policy}", (${voucher_value_}), (${voucher_quantity}),null,null, bit);

              }
                end
