    rule "activity-${offer_id}-2" ${offer_priority}
    	when
    		$activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${activity}"))) )
    	then
    		String ruleTag = "";
    		ReadHelper bitHeader = null;
    		ReadHelper bit = null;
    		ReadHelper bitPayment = null;
    		    ruleTag = "Track Activity with each Sponsor";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
            		$activity.getActionHelper().updateMTA(${offer_id}, "Track Activity with each Sponsor", String.valueOf(bitHeader.readAttributeS("h_sponsor_id")), "MA_O", "# of Visits per Sponsor", (1), "INCREMENT_BY", bit,"bit","h_sponsor_id");


        ruleTag = "Track Unique Sponsor Transaction";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member", String.valueOf(bitHeader.readAttributeS("h_sponsor_id")),"MA_O", "# of Visits per Sponsor", "${offer_id}") == 1)){
        	    		$activity.getActionHelper().updateMTA(${offer_id}, "Track Unique Sponsor Transaction", "MA_O", "# of Unique Sponsors Transacted with", (1), "INCREMENT_BY", bit);

        }ruleTag = "Reward for Milestone Completion";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member",null,"MA_O", "# of Unique Sponsors Transacted with", "${offer_id}") == (${unique_sponsor_transaction_target_1})) && (!($activity.readAttributeS("member",null,"MA_O", "Reward Received", "${offer_id}").contentEquals("Yes")))){
        	    		$activity.getActionHelper().assignPrivilege(${offer_id}, "Reward for Milestone Completion", "${voucher_1}", (${voucher_1_value}), (${voucher_1_quantity}),null,null, bit);
            		$activity.getActionHelper().updateMTA(${offer_id}, "Reward for Milestone Completion", "MA_O", "Reward Received", (String.valueOf("Yes")), "SET", bit);

        }
    end
