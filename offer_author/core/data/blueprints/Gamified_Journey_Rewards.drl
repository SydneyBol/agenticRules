  rule "activity-${offer_id}-2" ${offer_priority}
                  when
                    $activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${bit_type}"))) )
                  then
                    String ruleTag = "";
                    ReadHelper bitHeader = null;
                    ReadHelper bit = null;
                    ReadHelper bitPayment = null;
                      ruleTag = "Track Purchase on 1st Eligible Product";
                        for(int line = 0; line < $activity.getBitLines().size(); line++){
                          bitHeader = $activity.getHeaderReadHelper();
                          bit = $activity.getLineReadHelper(line);
                          if(${line_eligibility_check} && ($activity.existInListS(bit.readAttributeS("category"), "${eligible_product_category_}"))) {
                              		$activity.getActionHelper().updateMTA(${offer_id}, "Track Purchase on 1st Eligible Product", "MA_A", "Spend on 1st Category", (((bit.readAttributeN("l_quantity"))*(bit.readAttributeN("l_amount")))), "INCREMENT_BY", bit);

                          }
                        }
    ruleTag = "Reward on Minimum Purchase of 1st Eligible Product";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeN("member",null,"MA_A", "Spend on 1st Category", "${offer_id}") >= (${category_1_spend_threshold}))){
                  		$activity.getActionHelper().pointsAction("${loyalty_tag}", ${offer_id}, "Reward on Minimum Purchase of 1st Eligible Product", "REWARD_POINTS", "${loyalty_account}", (((${first_purchase_multiplier})*($activity.readAttributeN("member",null,"MA_A", "Spend on 1st Category", "${offer_id}")))), bit);

      		$activity.getActionHelper().updateMTA(${offer_id}, "Reward on Minimum Purchase of 1st Eligible Product", "MA_O", "Unlock Second Reward", (String.valueOf("Yes")), "SET", bit);

              }
    ruleTag = "Track and Reward on 2nd Eligible Category";
                        for(int line = 0; line < $activity.getBitLines().size(); line++){
                          bitHeader = $activity.getHeaderReadHelper();
                          bit = $activity.getLineReadHelper(line);
                          if(${line_eligibility_check} && ($activity.existInListS(bit.readAttributeS("category"), "${eligible_product_category_2}"))) {
                              		$activity.getActionHelper().updateMTA(${offer_id}, "Track and Reward on 2nd Eligible Category", "MA_A", "Spend on 2nd Category", (((bit.readAttributeN("l_quantity"))*(bit.readAttributeN("l_amount")))), "INCREMENT_BY", bit);

                          }
                        }
    ruleTag = "Reward on Minimum Purchase of 2nd Eligible Product";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeN("member",null,"MA_A", "Spend on 2nd Category", "${offer_id}") >= (${category_2_spend_threshold})) &&
      ($activity.readAttributeS("member",null,"MA_O", "Unlock Second Reward", "${offer_id}").contentEquals("Yes"))){
                  		$activity.getActionHelper().pointsAction("${loyalty_tag}", ${offer_id}, "Reward on Minimum Purchase of 2nd Eligible Product", "REWARD_POINTS", "${loyalty_account}", (((${second_purchase_multiplier})*($activity.readAttributeN("member",null,"MA_A", "Spend on 2nd Category", "${offer_id}")))), bit);

      		$activity.getActionHelper().updateMTA(${offer_id}, "Reward on Minimum Purchase of 2nd Eligible Product", "MA_O", "Unlock Third Reward", (String.valueOf("Yes")), "SET", bit);

              }
    ruleTag = "Track and Reward on 3rd Eligible Category";
                        for(int line = 0; line < $activity.getBitLines().size(); line++){
                          bitHeader = $activity.getHeaderReadHelper();
                          bit = $activity.getLineReadHelper(line);
                          if(${line_eligibility_check} && ($activity.existInListS(bit.readAttributeS("category"), "${eligible_product_category_3}"))) {
                              		$activity.getActionHelper().updateMTA(${offer_id}, "Track and Reward on 3rd Eligible Category", "MA_A", "Spend on 3rd Category", (((bit.readAttributeN("l_quantity"))*(bit.readAttributeN("l_amount")))), "INCREMENT_BY", bit);

                          }
                        }
    ruleTag = "Reward on Minimum Purchase of 3rd Eligible Product";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeN("member",null,"MA_A", "Spend on 3rd Category", "${offer_id}") >= (${category_3_spend_threshold})) &&
      ($activity.readAttributeS("member",null,"MA_O", "Unlock Third Reward", "${offer_id}").contentEquals("Yes"))){
                  		$activity.getActionHelper().pointsAction("${loyalty_tag}", ${offer_id}, "Reward on Minimum Purchase of 3rd Eligible Product", "REWARD_POINTS", "${loyalty_account}", (((${third_purchase_multiplier})*($activity.readAttributeN("member",null,"MA_A", "Spend on 3rd Category", "${offer_id}")))), bit);

              }
                end
