    rule "activity-${offer_id}-2" ${offer_priority}
    	when
    		$activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${activity}"))) )
    	then
    		String ruleTag = "";
    		ReadHelper bitHeader = null;
    		ReadHelper bit = null;
    		ReadHelper bitPayment = null;
    		    ruleTag = "Track Activity at each Location";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
            		$activity.getActionHelper().updateMTA(${offer_id}, "Track Activity at each Location", String.valueOf(bitHeader.readAttributeS("h_location")), "MA_O", "# of Visits per Location", (1), "INCREMENT_BY", bit,"bit","h_location");


        ruleTag = "Track Transaction with Unique Locations";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member", String.valueOf(bitHeader.readAttributeS("h_location")),"MA_O", "# of Visits per Location", "${offer_id}") == 1)){
        	    		$activity.getActionHelper().updateMTA(${offer_id}, "Track Transaction with Unique Locations", "MA_O", "# of Unique Locations", (1), "INCREMENT_BY", bit);

        }ruleTag = "Reward for Milestone 1 Completion";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member",null,"MA_O", "# of Unique Locations", "${offer_id}") == (${unique_transaction_target_1})) && (!($activity.readAttributeS("member",null,"MA_O", "Milestone 1 Rewarded", "${offer_id}").contentEquals("Yes")))){
        	    		$activity.getActionHelper().assignPrivilege(${offer_id}, "Reward for Milestone 1 Completion", "${voucher_1}", (${voucher_1_value}), (${voucher_1_quantity}),null,null, bit);
            		$activity.getActionHelper().updateMTA(${offer_id}, "Reward for Milestone 1 Completion", "MA_O", "Milestone 1 Rewarded", (String.valueOf("Yes")), "SET", bit);

        }ruleTag = "Reward for Milestone 2 Completion";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member",null,"MA_O", "# of Unique Locations", "${offer_id}") == (${unique_transaction_target_2})) && (!($activity.readAttributeS("member",null,"MA_O", "Milestone 2 Rewarded", "${offer_id}").contentEquals("Yes")))){
        	    		$activity.getActionHelper().assignPrivilege(${offer_id}, "Reward for Milestone 2 Completion", "${voucher_2}", (${voucher_2_value}), (${voucher_2_quantity}),null,null, bit);
            		$activity.getActionHelper().updateMTA(${offer_id}, "Reward for Milestone 2 Completion", "MA_O", "Milestone 2 Rewarded", (String.valueOf("Yes")), "SET", bit);

        }ruleTag = "Reward for Milestone 3 Completion";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member",null,"MA_O", "# of Unique Locations", "${offer_id}") == (${unique_transaction_target_3})) && (!($activity.readAttributeS("member",null,"MA_O", "Milestone 3 Rewarded", "${offer_id}").contentEquals("Yes")))){
        	    		$activity.getActionHelper().assignPrivilege(${offer_id}, "Reward for Milestone 3 Completion", "${voucher_3}", (${voucher_3_value}), (${voucher_3_quantity}),null,null, bit);
            		$activity.getActionHelper().updateMTA(${offer_id}, "Reward for Milestone 3 Completion", "MA_O", "Milestone 3 Rewarded", (String.valueOf("Yes")), "SET", bit);

        }
    end
