rule "segmentation-tier_name_dynamic_5vm7vge5n"
when
    $segment : MemberSegmentExecutionContext(evaluateTierTextAttribute("Bronze", "=", "name", "TIER", "Elite_Levels") && evaluateNumberAttribute("18", ">", "age", "PROGRAM"))
then
    $segment.addValidatedSegmentId("tier_name_dynamic_5vm7vge5n");
end