    rule "activity-${offer_id}-2" ${offer_priority}
    	when
    		$activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${activity}"))) )
    	then
    		String ruleTag = "";
    		ReadHelper bitHeader = null;
    		ReadHelper bit = null;
    		ReadHelper bitPayment = null;
    		    ruleTag = "Track Payment Transaction";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
            		$activity.getActionHelper().updateMTA(${offer_id}, "Track Payment Transaction", "MA_O", "Track Amount", (bitHeader.readAttributeN("h_bit_amount")), "INCREMENT_BY", bit);
            		$activity.getActionHelper().updateMTA(${offer_id}, "Track Payment Transaction", "MA_O", "Track Payment", (1), "INCREMENT_BY", bit);
            		$activity.getActionHelper().updateMTA(${offer_id}, "Track Payment Transaction", "MA_O", "Track Transaction Date", (DateUtils.getDate(bitHeader.readAttributeS("h_bit_date"))), "SET", bit);


        ruleTag = "Reward for Consecutive Payments";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member",null,"MA_O", "Track Payment", "${offer_id}") == (${milestone_1}))){
        	    		$activity.getActionHelper().pointsAction("${loyalty_account_tag}", ${offer_id}, "Reward for Consecutive Payments", "REWARD_POINTS", "${loyalty_account}", (((((${multiplier})/(100)))*(bitHeader.readAttributeN("h_bit_amount")))), bit);

        }
    end



    rule "event-${offer_id}-2"
    	when
    		$activity : BitExecutionContext(${header_eligibility_check} && readAttributeS("h_bit_type") == "EVENT")
    	then
    		ReadHelper bitHeader = null;
    		ReadHelper bit = null;
    		String offerTag = "2";
    		String ruleTag = "";
    	    ruleTag = "Track Regular Monthly Payments";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readMemberAttributeD("MONTH","MA_O", "Track Transaction Date", "${offer_id}") != ($activity.readAttributeD("h_bit_date", "MONTH")))){
        	    		$activity.getActionHelper().updateMTA(${offer_id}, "Track Regular Monthly Payments", "MA_O", "Track Amount", 0, "RESET", bit);
            		$activity.getActionHelper().updateMTA(${offer_id}, "Track Regular Monthly Payments", "MA_O", "Track Payment", 0, "RESET", bit);

        }
    end
