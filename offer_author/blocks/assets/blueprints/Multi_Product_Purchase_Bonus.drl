    rule "activity-${offer_id}-4" ${offer_priority}
    	when
    		$activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${activity_}"))) )
    	then
    		String ruleTag = "";
    		ReadHelper bitHeader = null;
    		ReadHelper bit = null;
    		ReadHelper bitPayment = null;
    		    ruleTag = "Track Product Purchase";

        for(int line = 0; line < $activity.getBitLines().size(); line++){
        	bitHeader = $activity.getHeaderReadHelper();
        	bit = $activity.getLineReadHelper(line);
        	if(${line_eligibility_check} && ($activity.existInListS(bit.readAttributeS("l_product_external_id"), "${product_id_1}")) && (!($activity.readAttributeS("member",null,"MA_O", "Bonus Rewarded", "${offer_id}").contentEquals("Yes"))) && ($activity.readAttributeN("member", String.valueOf(bit.readAttributeS("l_product_external_id")),"MA_A", "# of Products Purchased", "${offer_id}") < (1))) {
        		    		$activity.getActionHelper().updateMTA(${offer_id}, "Track Product Purchase", String.valueOf((bit.readAttributeS("l_product_external_id"))), "MA_A", "# of Products Purchased", (1), "INCREMENT_BY", bit,"member","null");
            		$activity.getActionHelper().updateMTA(${offer_id}, "Track Product Purchase", "MA_A", "Unique Product Purchases", (1), "INCREMENT_BY", bit);

        	}
        }ruleTag = "Reward Member on Unique Products Purchase";
        bitHeader = $activity.getHeaderReadHelper();
        bit = $activity.getHeaderReadHelper();
        if(($activity.readAttributeN("member",null,"MA_A", "Unique Product Purchases", "${offer_id}") == (${number_of_unique_product_purchasednumber_of_prod})) && (!($activity.readAttributeS("member",null,"MA_O", "Bonus Rewarded", "${offer_id}").contentEquals("Yes")))){
        	    		$activity.getActionHelper().assignPrivilege(${offer_id}, "Reward Member on Unique Products Purchase", "${voucher_1}", (${voucher_1_value}), (${voucher_1_quantity}),null,null, bit);
            		$activity.getActionHelper().updateMTA(${offer_id}, "Reward Member on Unique Products Purchase", "MA_O", "Bonus Rewarded", (String.valueOf("Yes")), "SET", bit);

        }
    end
