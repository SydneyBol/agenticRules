  rule "activity-${offer_id}-2" ${offer_priority}
                  when
                    $activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${bit_type}"))) )
                  then
                    String ruleTag = "";
                    ReadHelper bitHeader = null;
                    ReadHelper bit = null;
                    ReadHelper bitPayment = null;
                      ruleTag = "Track Transaction with First Industry Target";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.existInListS($activity.readSponsorAttributeS("industry"), "${first_industry_target}"))){
                  		$activity.getActionHelper().updateMTA(${offer_id}, "Track Transaction with First Industry Target", "MA_O", "First Industry Target", (String.valueOf("Yes")), "SET", bit);

              }
    ruleTag = "Track Transaction with Second Industry Target";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.existInListS($activity.readSponsorAttributeS("industry"), "${second_industry_target}"))){
                  		$activity.getActionHelper().updateMTA(${offer_id}, "Track Transaction with Second Industry Target", "MA_O", "Second Industry Target", (String.valueOf("Yes")), "SET", bit);

              }
    ruleTag = "Track Transaction with Third Industry Target";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.existInListS($activity.readSponsorAttributeS("industry"), "${third_industry_target}"))){
                  		$activity.getActionHelper().updateMTA(${offer_id}, "Track Transaction with Third Industry Target", "MA_O", "Third Industry Target", (String.valueOf("Yes")), "SET", bit);

              }
    ruleTag = "Track Transaction with Fourth Industry Target";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.existInListS($activity.readSponsorAttributeS("industry"), "${fourth_industry_target}"))){
                  		$activity.getActionHelper().updateMTA(${offer_id}, "Track Transaction with Fourth Industry Target", "MA_O", "Fourth Industry Target", (String.valueOf("Yes")), "SET", bit);

              }
    ruleTag = "Track Transaction with Fifth Industry Target";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.existInListS($activity.readSponsorAttributeS("industry"), "${fifth_industry_target}"))){
                  		$activity.getActionHelper().updateMTA(${offer_id}, "Track Transaction with Fifth Industry Target", "MA_O", "Fifth Industry Target", (String.valueOf("Yes")), "SET", bit);

              }
    ruleTag = "Reward Bonus Points";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeS("member",null,"MA_O", "First Industry Target", "${offer_id}").contentEquals("Yes")) &&
      ($activity.readAttributeS("member",null,"MA_O", "Second Industry Target", "${offer_id}").contentEquals("Yes")) &&
      ($activity.readAttributeS("member",null,"MA_O", "Third Industry Target", "${offer_id}").contentEquals("Yes")) &&
      ($activity.readAttributeS("member",null,"MA_O", "Fourth Industry Target", "${offer_id}").contentEquals("Yes")) &&
      ($activity.readAttributeS("member",null,"MA_O", "Fifth Industry Target", "${offer_id}").contentEquals("Yes")) &&
      (!($activity.readAttributeS("member",null,"MA_O", "Bonus Received", "${offer_id}").contentEquals("Yes")))){
                  		$activity.getActionHelper().pointsAction("${tag}", ${offer_id}, "Reward Bonus Points", "REWARD_POINTS", "${loyalty_account}", (${bonus_points_}), bit);

      		$activity.getActionHelper().updateMTA(${offer_id}, "Reward Bonus Points", "MA_O", "Bonus Received", (String.valueOf("Yes")), "SET", bit);

              }
                end
