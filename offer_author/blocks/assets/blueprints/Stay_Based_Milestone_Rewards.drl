  rule "activity-${offer_id}-2" ${offer_priority}
                  when
                    $activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && (readAttributeS("h_bit_type") == "STAY" &&
    ((DateUtils.getDate(readAttributeS("h_date_of_booking")).compareTo(DateUtils.getDate("${promotion_period}"))>0)&&(DateUtils.getDate(readAttributeS("h_date_of_booking")).compareTo(DateUtils.getDate("${promotion_end_date}"))<0))) )
                  then
                    String ruleTag = "";
                    ReadHelper bitHeader = null;
                    ReadHelper bit = null;
                    ReadHelper bitPayment = null;
                      ruleTag = "Track Stays with Brands";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if((bitHeader.readAttributeN("h_bit_amount") >= (${minimum_spend_amount}))){
                  		$activity.getActionHelper().updateMTA(${offer_id}, "Track Stays with Brands", String.valueOf(bitHeader.readAttributeS("h_sponsor_id")), "MA_O", "Stays Completed", (1), "INCREMENT_BY", bit,"bit","h_sponsor_id");

      ruleTag = "Stay with First Brand";
                bitHeader = $activity.getHeaderReadHelper();
                bit = $activity.getHeaderReadHelper();
                if(($activity.readMTOComponentN("member", String.valueOf(bitHeader.readAttributeS("h_sponsor_id")),"MA_O", "Stays Completed", "${offer_id}", "unique") >= (${unique_sponsor_threshold_1})) &&
        ($activity.readAttributeN("member",null,"MA_O", "Milestones Completed", "${offer_id}") < 1)){
                    		$activity.getActionHelper().updateMTA(${offer_id}, "Stay with First Brand", "MA_O", "Milestones Completed", (1), "INCREMENT_BY", bit);

                }
      ruleTag = "Stay with Second Brand";
                bitHeader = $activity.getHeaderReadHelper();
                bit = $activity.getHeaderReadHelper();
                if(($activity.readMTOComponentN("member", String.valueOf(bitHeader.readAttributeS("h_sponsor_id")),"MA_O", "Stays Completed", "${offer_id}", "unique") >= (${unique_sponsor_threshold2})) &&
        ($activity.readAttributeN("member",null,"MA_O", "Milestones Completed", "${offer_id}") == 1)){
                    		$activity.getActionHelper().updateMTA(${offer_id}, "Stay with Second Brand", "MA_O", "Milestones Completed", (1), "INCREMENT_BY", bit);

                }
      ruleTag = "Stay with Third Brand";
                bitHeader = $activity.getHeaderReadHelper();
                bit = $activity.getHeaderReadHelper();
                if(($activity.readMTOComponentN("member", String.valueOf(bitHeader.readAttributeS("h_sponsor_id")),"MA_O", "Stays Completed", "${offer_id}", "unique") >= (${unique_sponsor_threshold_3_})) &&
        ($activity.readAttributeN("member",null,"MA_O", "Milestones Completed", "${offer_id}") == 2)){
                    		$activity.getActionHelper().pointsAction("${tag}", ${offer_id}, "Stay with Third Brand", "REWARD_POINTS", "${loyalty_account}", (${bonus_points}), bit);

        		$activity.getActionHelper().updateMTA(${offer_id}, "Stay with Third Brand", "MA_O", "Milestones Completed", (1), "INCREMENT_BY", bit);

                }
      ruleTag = "Stay with Fourth Brand";
                bitHeader = $activity.getHeaderReadHelper();
                bit = $activity.getHeaderReadHelper();
                if(($activity.readMTOComponentN("member", String.valueOf(bitHeader.readAttributeS("h_sponsor_id")),"MA_O", "Stays Completed", "${offer_id}", "unique") >= (${unique_sponsor_threshold_4})) &&
        ($activity.readAttributeN("member",null,"MA_O", "Milestones Completed", "${offer_id}") == 3)){
                    		$activity.getActionHelper().pointsAction("${tag}", ${offer_id}, "Stay with Fourth Brand", "REWARD_POINTS", "${loyalty_account}", (${reward_for_fourth_milestone}), bit);

        		$activity.getActionHelper().updateMTA(${offer_id}, "Stay with Fourth Brand", "MA_O", "Milestones Completed", (1), "INCREMENT_BY", bit);

                }
      ruleTag = "Stay with Fifth Brand";
                bitHeader = $activity.getHeaderReadHelper();
                bit = $activity.getHeaderReadHelper();
                if(($activity.readMTOComponentN("member", String.valueOf(bitHeader.readAttributeS("h_sponsor_id")),"MA_O", "Stays Completed", "${offer_id}", "unique") >= (${unique_sponsor_threshold_5_})) &&
        ($activity.readAttributeN("member",null,"MA_O", "Milestones Completed", "${offer_id}") == 4)){
                    		$activity.getActionHelper().pointsAction("${tag}", ${offer_id}, "Stay with Fifth Brand", "REWARD_POINTS", "${loyalty_account}", (${reward_for_fifth_milestone}), bit);

        		$activity.getActionHelper().updateMTA(${offer_id}, "Stay with Fifth Brand", "MA_O", "Milestones Completed", (1), "INCREMENT_BY", bit);

                }
              }
                end
