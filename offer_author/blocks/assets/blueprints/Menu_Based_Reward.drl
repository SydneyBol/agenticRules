  rule "activity-${offer_id}-2" ${offer_priority}
                  when
                    $activity : BitExecutionContext(${header_eligibility_check} && (readAttributeS("h_bit_type") != "EVENT")  && ((existInListS(readAttributeS("h_bit_type"), "${activity_type}"))) )
                  then
                    String ruleTag = "";
                    ReadHelper bitHeader = null;
                    ReadHelper bit = null;
                    ReadHelper bitPayment = null;
                      ruleTag = "Track Menu 1 Purchase";
                        for(int line = 0; line < $activity.getBitLines().size(); line++){
                          bitHeader = $activity.getHeaderReadHelper();
                          bit = $activity.getLineReadHelper(line);
                          if(${line_eligibility_check} && ($activity.existInListS(bit.readAttributeS("l_product_external_id"), "${menu_1}"))) {
                              		$activity.getActionHelper().updateMTA(${offer_id}, "Track Menu 1 Purchase", "MA_A", "Total Spend on Menu 1", (bit.readAttributeN("l_amount")), "INCREMENT_BY", bit);

      		$activity.getActionHelper().updateMTA(${offer_id}, "Track Menu 1 Purchase", "MA_A", "Quantity Purchased from Menu 1", (bit.readAttributeN("l_quantity")), "INCREMENT_BY", bit);

                          }
                        }
    ruleTag = "Reward on Purchase of Items from Menu 1";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeN("member",null,"MA_A", "Total Spend on Menu 1", "${offer_id}") >= (${spend_threshold_on_three_menu_set})) &&
      ($activity.readAttributeN("member",null,"MA_A", "Quantity Purchased from Menu 1", "${offer_id}") >= (${quantity_threshold_for_menu_1}))){
                  		$activity.getActionHelper().pointsAction("${tag}", ${offer_id}, "Reward on Purchase of Items from Menu 1", "REWARD_POINTS", "${loyalty_account}", (${bonus_points}), bit);

              }
    ruleTag = "Track Menu 2 Purchase";
                        for(int line = 0; line < $activity.getBitLines().size(); line++){
                          bitHeader = $activity.getHeaderReadHelper();
                          bit = $activity.getLineReadHelper(line);
                          if(${line_eligibility_check} && ($activity.existInListS(bit.readAttributeS("l_product_external_id"), "${menu_2}"))) {
                              		$activity.getActionHelper().updateMTA(${offer_id}, "Track Menu 2 Purchase", "MA_A", "Total Spend on Menu 2", (bit.readAttributeN("l_amount")), "INCREMENT_BY", bit);

      		$activity.getActionHelper().updateMTA(${offer_id}, "Track Menu 2 Purchase", "MA_A", "Quantity Purchased from Menu 2", (bit.readAttributeN("l_quantity")), "INCREMENT_BY", bit);

                          }
                        }
    ruleTag = "Reward on Purchase of Items from Menu 2";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeN("member",null,"MA_A", "Total Spend on Menu 2", "${offer_id}") >= (${spend_threshold_on_five_menu_set})) &&
      ($activity.readAttributeN("member",null,"MA_A", "Quantity Purchased from Menu 2", "${offer_id}") >= (${quantity_threshold_for_menu_2}))){
                  		$activity.getActionHelper().pointsAction("${tag}", ${offer_id}, "Reward on Purchase of Items from Menu 2", "REWARD_POINTS", "${loyalty_account}", (${bonus_points_mulitplier}), bit);

              }
    ruleTag = "Track Menu 3 Purchase";
                        for(int line = 0; line < $activity.getBitLines().size(); line++){
                          bitHeader = $activity.getHeaderReadHelper();
                          bit = $activity.getLineReadHelper(line);
                          if(${line_eligibility_check} && ($activity.existInListS(bit.readAttributeS("l_product_external_id"), "${menu_3}"))) {
                              		$activity.getActionHelper().updateMTA(${offer_id}, "Track Menu 3 Purchase", "MA_A", "Total Spend on Menu 3", (bit.readAttributeN("l_amount")), "INCREMENT_BY", bit);

      		$activity.getActionHelper().updateMTA(${offer_id}, "Track Menu 3 Purchase", "MA_A", "Quantty Purchased on Menu 3", (bit.readAttributeN("l_quantity")), "INCREMENT_BY", bit);

                          }
                        }
    ruleTag = "Reward on Purchase of Items from Menu 3";
              bitHeader = $activity.getHeaderReadHelper();
              bit = $activity.getHeaderReadHelper();
              if(($activity.readAttributeN("member",null,"MA_A", "Total Spend on Menu 3", "${offer_id}") >= (${spend_threshold_on_seven_menu_set})) &&
      ($activity.readAttributeN("member",null,"MA_A", "Quantty Purchased on Menu 3", "${offer_id}") >= (${quantity_threshold_for_menu_3}))){
                  		$activity.getActionHelper().pointsAction("${tag}", ${offer_id}, "Reward on Purchase of Items from Menu 3", "REWARD_POINTS", "${loyalty_account}", (${bonus_points_multiplier_for_7_menu_set}), bit);

              }
                end
